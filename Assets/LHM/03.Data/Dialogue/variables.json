    { "key": "story.chapter",       "type": "Int",    "scope": "Dialogue", "default": 0, "desc": "메인 스토리 챕터" },
    { "key": "dlg.junkTrust",       "type": "Int",    "scope": "Dialogue", "default": 0, "desc": "고물상 친밀도 (대사 분기용)" },
