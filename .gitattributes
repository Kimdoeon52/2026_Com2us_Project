# Auto detect text files and perform LF normalization
* text=auto
*.asset       text eol=lf
*.unity       text eol=lf
*.prefab      text eol=lf
*.meta        text eol=lf
*.mat         text eol=lf
*.anim        text eol=lf
*.controller  text eol=lf
*.json        text eol=lf
*.asmdef      text eol=lf
*.shadergraph text eol=lf