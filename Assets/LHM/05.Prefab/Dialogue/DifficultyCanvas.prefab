  m_EditorClassIdentifier: 
  difficulties:
  - id: veryEasy
    label: "\uC544\uC8FC \uC26C\uC6C0"
    subtitle: "\uCC98\uC74C \uB9CC\uB098\uB294 \uBCF4\uC2A4 \uC5F0\uC2B5\uC6A9"
    description: "\uD328\uD134 \uC18D\uB3C4\uC640 \uD53C\uD574\uAC00 \uD06C\uAC8C
      \uC904\uC5B4\uB4E0 \uC5F0\uC2B5 \uB09C\uC774\uB3C4\uC785\uB2C8\uB2E4. \uBCF4\uC2A4\uC758
      \uAE30\uBCF8 \uC6C0\uC9C1\uC784\uC744 \uC775\uD788\uAE30 \uC88B\uC2B5\uB2C8\uB2E4."
    risk: 1
    scoreLabel: "[\uC810\uC218]"
  - id: easy
    label: "\uC26C\uC6C0"
    subtitle: "\uD328\uD134 \uC608\uACE0 \uB109\uB109\uD568"
    description: "\uD328\uD134 \uC608\uACE0 \uC2DC\uAC04\uC774 \uAE38\uC5B4 \uB300\uC751\uD560
      \uC5EC\uC720\uAC00 \uC788\uC2B5\uB2C8\uB2E4."
    risk: 2
    scoreLabel: "[\uC810\uC218]"
  - id: normal
    label: "\uBCF4\uD1B5"
    subtitle: "\uAE30\uC900 \uB09C\uC774\uB3C4"
    description: "\uAE30\uD68D \uC758\uB3C4\uB300\uB85C\uC758 \uAE30\uC900 \uB09C\uC774\uB3C4\uC785\uB2C8\uB2E4.
      \uBAA8\uB4E0 \uAE30\uBBF9\uACFC \uBD80\uC704 \uACF5\uACA9\uC774 \uB4F1\uC7A5\uD569\uB2C8\uB2E4."
    risk: 3
    scoreLabel: "[\uC810\uC218]"
  - id: hard
    label: "\uC5B4\uB824\uC6C0"
    subtitle: "\uC608\uACE0 \uB2E8\uCD95 \xB7 \uC5F0\uC18D \uD328\uD134"
    description: "\uC608\uACE0 \uC2DC\uAC04\uC774 \uC9E7\uC544\uC9C0\uACE0 \uD328\uD134\uC774
      \uC5F0\uC18D\uC73C\uB85C \uC774\uC5B4\uC9D1\uB2C8\uB2E4."
    risk: 4
    scoreLabel: "[\uC810\uC218]"
  - id: hell
    label: "\uD5EC"
    subtitle: "1\uC704\uB97C \uB178\uB9B0\uB2E4\uBA74"
    description: "\uAC00\uC7A5 \uB192\uC740 \uB7AD\uD0B9 \uC810\uC218\uB97C \uC8FC\uB294
      \uCD5C\uACE0 \uB09C\uC774\uB3C4\uC785\uB2C8\uB2E4. \uC791\uC740 \uC2E4\uC218\uB3C4
      \uD30C\uCE20 \uD30C\uAD34\uB85C \uC774\uC5B4\uC9D1\uB2C8\uB2E4."
    risk: 5
    scoreLabel: "[\uC810\uC218]"
