  - Id: SK_LEG_STOMP
    DisplayName: "\uC2A4\uD1B0\uD504"
    TypeLabel: "\uBC18\uACBD 3.0 \xB7 \uACF5\uC911 \uC804\uC6A9"
    Description: "\uAE09\uAC15\uD558\uD574 \uCC29\uC9C0 \uCDA9\uACA9\uD30C\uB97C
