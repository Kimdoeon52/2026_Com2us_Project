    { "key": "guild.greeting.1", "value": "길드에 오신 걸 환영합니다. 오늘은 어떤 용무로 오셨나요?" },
    { "key": "guild.greeting.2", "value": "그냥 둘러보러 왔어요." },
    { "key": "guild.greeting_busy.1", "value": "시즌 중이라 정신이 없네요. 필요한 거 있으면 불러 주세요." },
    { "key": "guild.after_defeat.1", "value": "토벌 결과 확인했어요. 기체 상태부터 챙기세요." },
    { "key": "guild.after_defeat.2", "value": "...다음엔 결과 보고서가 다를 거예요." },
    { "key": "guild.after_win.1", "value": "토벌 성공 처리됐어요. 점수는 00시에 반영돼요." },
    { "key": "guild.top10_first.1", "value": "축하드려요! 10위권이에요. 이제 보드 맨 위쪽에서 이름이 보여요." },
    { "key": "guild.top10_first.2", "value": "...아직 위에 아홉 명이나 있네요." },

    { "key": "boss_entry.first.1", "value": "시즌 대상 보스 토벌, 접수됐어요. 상대는 호이루예요. 돌진 한 번에 기체가 반으로 접힌대요." },
    { "key": "boss_entry.first.2", "value": "고철 냄새가 나는군. 오늘 부품은 네 것으로 하지." },
    { "key": "boss_entry.first.3", "value": "...그 부품, 내가 먼저 뜯어 갈 거야." },
    { "key": "boss_entry.first_hell.1", "value": "첫 도전을 헬 난이도로요? 길드는 책임 못 져요." },
    { "key": "boss_entry.first_hell.2", "value": "겁도 없군. 톱날부터 맛봐라." },
    { "key": "boss_entry.first_hell.3", "value": "...어차피 한 번은 부딪혀야 하니까." },
    { "key": "boss_entry.retry.1", "value": "재도전 접수됐어요. 이번엔 돌아오세요." },
    { "key": "boss_entry.retry_hell.1", "value": "또 헬이요? ...행운을 빌어요." },
    { "key": "boss_entry.retry_wheel.1", "value": "호이루 재도전 접수됐어요. 바퀴 소리 잘 들으세요." },
    { "key": "boss_entry.kyodai_first.1", "value": "지역 2 대상 보스, 쿄다이 토벌 접수됐어요. 팔다리를 하나씩 묶어야 렌즈가 열린대요." },
    { "key": "boss_entry.kyodai_first.2", "value": "작은 것. 내 그림자 안으로 들어왔군." },
    { "key": "boss_entry.kyodai_first.3", "value": "...크다고 다 무거운 건 아니겠지." },
    { "key": "boss_entry.kyodai_retry.1", "value": "쿄다이 재도전이요. 무리하지 마세요." },
    { "key": "boss_entry.kyodai_hint.1", "value": "쿄다이한테 세 번이나... 팔다리를 전부 묶기 전엔 렌즈를 쳐도 소용없어요." },
    { "key": "boss_entry.kyodai_hint.2", "value": "...팔다리부터. 알겠어요." },
    { "key": "boss_entry.hint.1", "value": "잠깐만요. 지난 기록을 보니 세 번 다 돌진에 당하셨네요." },
    { "key": "boss_entry.hint.2", "value": "돌진 직전에 바퀴가 한 번 헛돌아요. 그때 옆으로 피하면 벽에 박혀서 잠깐 멈춰요." },
    { "key": "boss_entry.hint.3", "value": "...헛도는 소리. 기억해 둘게요." },

    { "key": "junk.greeting.1", "value": "왔냐. 쓸 만한 고철 있으면 가져와 봐." },
    { "key": "junk.after_defeat.1", "value": "또 부서져서 왔구먼. 고칠 순 없어도 뜯어 쓸 순 있지." },
    { "key": "junk.after_defeat.2", "value": "...쓸 만한 거 좀 골라 주세요." },

    { "key": "auction.first_meet.1", "value": "처음 보는 얼굴이네요. 그 고물상을 새로 맡았다는 분?" },
    { "key": "auction.first_meet.2", "value": "...네. 물건 좀 팔러 왔어요." },
    { "key": "auction.first_meet.3", "value": "좋아요. 매주 월요일 0시에 정산해요. 잘 부탁해요." },

    { "key": "auction.greeting.1", "value": "어서 와요. 오늘은 뭘 경매에 내놓으실 건가요?" },
    { "key": "auction.greeting.2", "value": "쓸 만한 팔 파츠가 하나 있어요." },
    { "key": "auction.greeting.3", "value": "상태 좀 볼까요... 좋네요. 이번 주 정산 때 결과 알려드릴게요." },
    { "key": "auction.greeting.4", "value": "(경매 등록이 완료되었다)" },

    { "key": "auction.greeting_quiet.1", "value": "오늘은 손님이 별로 없네요. 천천히 둘러보세요." },

    { "key": "auction.after_defeat.1", "value": "졌다면서요? 파츠 상태가 말이 아니네." },
    { "key": "auction.after_defeat.2", "value": "...다음엔 안 져요." },

    { "key": "auction.after_defeat_wheel.1", "value": "바퀴 녀석한테 당했다면서요? 그 녀석 돌진은 정면으로 받으면 안 돼요." },
    { "key": "auction.after_defeat_wheel.2", "value": "...알고 있어요." },

    { "key": "auction.after_win.1", "value": "이겼다면서요! 오늘은 좋은 값 받겠네요." },
    { "key": "auction.after_win.2", "value": "좋은 걸로 부탁해요." },

    { "key": "auction.after_win_hell.1", "value": "헬 난이도를 깼다고요? 그 고철 기체로요?" },
    { "key": "auction.after_win_hell.2", "value": "...고철도 고철 나름이에요." },
    { "key": "auction.sold.1", "value": "이번 주 물건, 전부 팔렸어요. 정산금은 길드 계좌로 넣어 뒀어요." },
    { "key": "auction.sold.2", "value": "...생각보다 값이 괜찮네." },


    { "key": "test.prologue.1", "value": "10년 전. A사 지하 연구동." },
    { "key": "test.prologue.2", "value": "설계도는 어디 있지?" },
    { "key": "test.prologue.3", "value": "결함 없는 코어의 설계도는 길드 레이스 최종 보스 안에 있다." },
    { "key": "test.prologue.4", "value": "넌 절대 손에 넣지 못할 거다." },

    { "key": "test.intermission.1", "value": "보고드립니다. 다른 회사 부품을 섞어 쓰는 신인이 10위권에 들어왔습니다." },
    { "key": "test.intermission.2", "value": "...섞어 쓴다고?" },
    { "key": "test.intermission.3", "value": "그 기체, 끝까지 지켜봐." },

    { "key": "event.top10_first.1", "value": "자정, 길드 랭킹 보드가 갱신됐다. 10위 칸에 처음 보는 이름이 올라왔다." },
    { "key": "event.top10_first.2", "value": "...고철 모아 만든 기체로 여기까지 왔다." },
    { "key": "event.top10_first.3", "value": "그날 밤, 위쪽 아홉 개의 이름 중 누군가가 그 이름을 지켜보기 시작했다." },
    { "key": "event.chairman_suspicion.1", "value": "10위권에 처음 보는 이름이 올라왔군." },
    { "key": "event.chairman_suspicion.2", "value": "그 코어... 어디서 났는지 알아봐." },
    { "key": "event.season_ending.1", "value": "길드 연락이에요. 이번 시즌 종료까지 7일 남았어요." },
    { "key": "event.season_ending.2", "value": "포상은 시즌 최종 순위로 정해지니까, 남은 토벌 일정 잘 챙기세요." },
    { "key": "event.season_call_question.1", "value": "여보세요, 길드 접수처예요!" },
    { "key": "event.season_call_question.2", "value": "레이스가 곧 시작되는데, 이번 시즌은 어떤 지역에 도전하시겠어요?" },
    { "key": "event.season_call_confirm.1", "value": "네, 확인했습니다! {boss} 보스 맞으시죠?" },
    { "key": "event.season_call_accept.1", "value": "좋아요! {region} {boss} 레이스로 등록해 둘게요. 시즌 시작까지 준비 단단히 하세요!" },
    { "key": "event.bubble_guild_after_defeat.1", "value": "토벌, 잘 안 풀렸다면서요?" },
    { "key": "event.bubble_guild_after_defeat_wheel.1", "value": "호이루한테 당했다면서요?" },
    { "key": "event.bubble_auction_sold.1", "value": "어제 물건, 다 팔렸어요!" },
    { "key": "crowd.fallback.1", "value": "와아아!" },
    { "key": "crowd.cheer_break.1", "value": "부숴버려!" },
    { "key": "crowd.cheer_scrap.1", "value": "오늘은 누가 고철이 될까?" },
    { "key": "crowd.cheer_wheel.1", "value": "호이루! 호이루!" },
    { "key": "crowd.cheer_kyodai.1", "value": "쿄다이가 밟는다!" },
    { "key": "crowd.basic_parts_easy.1", "value": "고철 덩어리로 나왔네!" },
    { "key": "crowd.hell.1", "value": "헬 난이도래! 미쳤어!" },
    { "key": "mono.receptionist.fallback.1", "value": "오늘도 토벌 신청이 밀려 있네..." },
    { "key": "mono.receptionist.season_end.1", "value": "시즌 마감 전엔 늘 이렇게 바쁘다니까." },
    { "key": "mono.junkdealer.fallback.1", "value": "어디 쓸 만한 고철 없나..." },
    { "key": "mono.junkdealer.basic_parts.1", "value": "기본 파츠로 버티는 녀석이 또 있군." },
    { "key": "mono.auctioneer.fallback.1", "value": "이번 주 출품작은... 흠." },
    { "key": "mono.auctioneer.sold.1", "value": "지난번 낙찰가, 꽤 좋았지." },
    { "key": "bark.fallback.1", "value": "집중하자." },
    { "key": "bark.player_part.1", "value": "파츠가 나갔어...!" },
    { "key": "bark.player_head.1", "value": "머리가... 화면이 흔들려!" },
    { "key": "bark.player_left_arm.1", "value": "왼팔이 안 움직여!" },
    { "key": "bark.player_right_arm.1", "value": "오른팔이 끊겼어!" },
    { "key": "bark.player_left_leg.1", "value": "왼다리가 나갔어... 버텨!" },
    { "key": "bark.player_right_leg.1", "value": "오른다리가 꺾였어!" },
    { "key": "bark.player_many.1", "value": "남은 파츠가 얼마 없어... 코어만은 지켜야 해." },
    { "key": "bark.boss_part.1", "value": "부위 파괴! 계속 몰아붙여!" },
    { "key": "bark.boss_tire.1", "value": "내 바퀴가...! 이 고철 놈이!" },
    { "key": "bark.boss_groggy.1", "value": "멈췄다... 지금이야!" },
    { "key": "bark.boss_groggy_low.1", "value": "아직... 끝나지 않았다...!" },
    { "key": "bark.kyodai_groggy.1", "value": "...내 몸이, 멈춰...?" },

    { "key": "tutorial.t3_map.1", "value": "지도에서 가고 싶은 곳을 고르면 이동해. 이동하면 시간이 흘러." },
    { "key": "tutorial.t3_map.2", "value": "하루는 길지 않아. 어디부터 갈지 잘 정하자." },
    { "key": "tutorial.t9_hunt_apply.1", "value": "난이도가 높을수록 포상도 커지지만, 신청비도 올라가요." },
    { "key": "tutorial.t9_hunt_apply.2", "value": "신청 전에 파츠 내구도를 꼭 확인하세요." },
    { "key": "tutorial.t10_battle.1", "value": "좌우 이동, 위로 점프. Space로 피한다." },
    { "key": "tutorial.t10_battle.2", "value": "D는 기본기. 탄이 떨어지면 잠깐 장전해야 해." },
    { "key": "tutorial.t10_battle.3", "value": "Q W E R은 팔다리 파츠 기술. 부서진 파츠는 못 써." },
    { "key": "tutorial.t12_first_defeat.1", "value": "꼴이 말이 아니군. 부서진 파츠는 내구도가 0이 된 거다." },
    { "key": "tutorial.t12_first_defeat.2", "value": "코어가 불안정하면 다음 전투가 위험해. 수리부터 하고 가." },

    { "key": "workbench.idle.1", "value": "……" }
  ]
}
