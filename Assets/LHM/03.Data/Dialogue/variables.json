    { "key": "player.brokenPartCount", "type": "Int",  "scope": "Game", "default": 0, "desc": "현재 전투에서 파괴된 파츠 수" },
    { "key": "player.gold",         "type": "Int",    "scope": "Game", "default": 0 },
