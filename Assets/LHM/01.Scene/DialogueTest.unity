  entries:
  - bossId: boss.wheel
    regionLabel: 1
    bossName: "\uD638\uC774\uB8E8"
    typeLabel: "\uBC14\uD034\uD615"
    tags: "\uBC14\uD034\uD615 \xB7 \uD280\uC5B4\uC624\uB974\uAE30 / \uB3CC\uC9C4
      / \uB0B4\uB824\uCC0D\uAE30"
    description: "\uBC14\uB2E5\uACFC \uCC9C\uC7A5\uC744 \uD280\uC5B4 \uC624\uB974\uBA70
      360\uB3C4 \uD22C\uC0AC\uCCB4\uB97C \uBFCC\uB9AC\uACE0, \uB9F5 \uB05D\uAE4C\uC9C0
      \uB3CC\uC9C4\uD569\uB2C8\uB2E4. \uB3CC\uC9C4 \uC804\uC5D0 \uD53C\uD574\uB97C
      \uB204\uC801\uD558\uBA74 \uC2A4\uD134\uC744 \uB178\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    icon: {fileID: 21300000, guid: 90845d2f96f42be499d93b360ea2719e, type: 3}
    targetParts: "\uC624\uB978\uD314, \uC67C\uB2E4\uB9AC, \uBA38\uB9AC"
  - bossId: boss.kyodai
    regionLabel: 2
    bossName: "\uCFC4\uB2E4\uC774"
    typeLabel: "\uAC70\uB300 \uB85C\uBD07\uD615"
    tags: "\uAC70\uB300 \uB85C\uBD07 \xB7 \uBCF8\uCCB4\uB294 \uBC30\uACBD, \uD314\xB7\uB2E4\uB9AC\xB7\uB80C\uC988\uB9CC
      \uD53C\uACA9"
    description: "\uAC70\uB300\uD55C \uBCF8\uCCB4\uB294 \uBC30\uACBD\uC5D0 \uC788\uACE0
      \uD314\xB7\uB2E4\uB9AC\uC640 \uBA54\uC778 \uB80C\uC988\uB9CC \uACF5\uACA9\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uB0C9\uAC01\uD0D1\uACFC \uC548\uD14C\uB098\uB97C
      \uBD80\uC218\uBA74 \uD2C8\uC774 \uC0DD\uAE41\uB2C8\uB2E4."
    icon: {fileID: 21300000, guid: 84381088a98fd534eb644e2d1f506cbb, type: 3}
    targetParts: 
